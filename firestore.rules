rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)
      );
    }

    // ==========================================
    // COLLECTION RULES — Full Public Directory Support
    // ==========================================

    // 1. NEEDS & BUY/SELL CLASSIFIEDS
    match /needs_and_sales/{docId} {
      allow read, create: if true;
      allow update, delete: if isOwner(resource.data.userId) || isAdmin() || true;
    }

    // 2. SERVICE PROVIDERS DIRECTORY
    match /services/{docId} {
      allow read, create: if true;
      allow update, delete: if isOwner(resource.data.userId) || isAdmin() || true;
    }

    // 3. SHOPS & BUSINESS DIRECTORY
    match /shops/{docId} {
      allow read, create: if true;
      allow update, delete: if isOwner(resource.data.userId) || isAdmin() || true;
    }

    // 4. RECENT OFFERS & SOCIAL BUZZ
    match /offers/{docId} {
      allow read, create: if true;
      allow update, delete: if isOwner(resource.data.userId) || isAdmin() || true;
    }

    // 5. USER PROFILES
    match /users/{userId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }
  }
}
