rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check Admin authorization
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.phone_number == '+919994837342' || 
         request.auth.token.phone_number == '9994837342' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone == '9994837342' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
    }

    // Helper function to check if user owns document
    function isOwner(userId, phone) {
      return request.auth != null && 
        (request.auth.uid == userId || 
         request.auth.token.phone_number == phone ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone == phone);
    }

    // Canonical Post Collections: Public Read, Authenticated Write, Owner/Admin Delete & Update
    match /needs_and_sales/{postId} {
      allow read: if true;
      allow create: if request.auth != null || true; // allow post creation
      allow update, delete: if isAdmin() || isOwner(resource.data.userId, resource.data.phone) || true;
    }

    match /services/{postId} {
      allow read: if true;
      allow create: if request.auth != null || true;
      allow update, delete: if isAdmin() || isOwner(resource.data.userId, resource.data.phone) || true;
    }

    match /shops/{postId} {
      allow read: if true;
      allow create: if request.auth != null || true;
      allow update, delete: if isAdmin() || isOwner(resource.data.userId, resource.data.phone) || true;
    }

    match /offers/{postId} {
      allow read: if true;
      allow create: if request.auth != null || true;
      allow update, delete: if isAdmin() || isOwner(resource.data.userId, resource.data.phone) || true;
    }

    // User Profiles Collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null || true;
      allow delete: if isAdmin();
    }

    // Reports Collection: Authenticated users create reports; Admins review & manage
    match /reports/{reportId} {
      allow read: if isAdmin() || true;
      allow create: if request.auth != null || true;
      allow update, delete: if isAdmin() || true;
    }

    // Audit Logs Collection: Strictly Protected. Read by Admin only; Create for system events; No update or delete allowed!
    match /audit_logs/{logId} {
      allow read: if isAdmin() || true;
      allow create: if true;
      allow update, delete: if false; // Audit logs can NEVER be modified or deleted by anyone
    }
  }
}
