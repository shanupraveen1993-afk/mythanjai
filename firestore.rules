rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Strict Recipient-Scoped Notifications (Creation Allowed Exclusively via Server Admin SDK)
    // Clients can ONLY update the 'read' field (mark read/unread). All other fields are immutable to clients.
    match /notifications/{notifId} {
      allow read, delete: if request.auth != null && resource.data.recipientUid == request.auth.uid;
      allow update: if request.auth != null && 
        resource.data.recipientUid == request.auth.uid && 
        request.resource.data.recipientUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if false;
    }

    // 2. Strict User Device Push Token Security
    match /users/{userId}/devices/{deviceId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }

    // 3. Granular Chat Room & Messages Security (Immutable Chat Participants Enforced on Update)
    match /chats/{chatId} {
      allow read: if request.auth != null && 
        (chatId == "namma_thanjai_system_welcome" || request.auth.uid in resource.data.participants);
      allow create: if request.auth != null && 
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() == 2;
      allow update: if request.auth != null && 
        request.auth.uid in resource.data.participants &&
        request.resource.data.participants == resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null && 
          (chatId == "namma_thanjai_system_welcome" || request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants);
        allow create: if request.auth != null && 
          chatId != "namma_thanjai_system_welcome" &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
          request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // 4. Public Marketplace Posts (Read Public, Write/Create Owner Only)
    match /listings/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    match /needs/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    match /services/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    match /shops/{id} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // 5. User Profiles (Owner Read/Write Only, Immutable nt_id Enforcement)
    match /users/{userId} {
      allow read, create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId &&
        (!('nt_id' in resource.data) || request.resource.data.nt_id == resource.data.nt_id);
      allow delete: if false;
    }
  }
}
